# 이 파일을 저장소 루트의 `.env`로 복사해 값을 채운다. `.env`는 Git에 올리지 않는다.
# 이 파일에는 실제 값을 쓰지 않는다(키 이름만).
# 선택 항목은 필요할 때만 `#`을 지우고 값을 쓴다. 값을 비워 둔 채 켜 두면 코드의 기본값이 무시된다.

# --- 공통 Neo4j (필수) ---
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# --- OpenAI (필수: LLM 호출과 임베딩) ---
OPENAI_API_KEY=

# --- 선택: LLM 모델 지정 (없으면 코드 기본값 gpt-6-luna) ---
# SCHOOL_ROUTER_MODEL=
# SCHOOL_RERANK_MODEL=
# SCHOOL_ANSWER_MODEL=
# SCHOOL_EXTRACTION_MODEL=
# TEXT2CYPHER_MODEL=

# --- 호흡기 행동 추출기(index.respiratory.extractor)를 실행할 때만 필수 ---
# OPENAI_MODEL=

# --- 선택: Text2Cypher 시연용 별도 읽기 계정 (없으면 NEO4J_USERNAME 계정을 쓴다) ---
# NEO4J_READONLY_USERNAME=
# NEO4J_READONLY_PASSWORD=

# --- 선택: 화면 보호와 질문 이력 (Streamlit) ---
# APP_PASSWORD=        # 설정하면 화면 진입 시 비밀번호를 묻는다
# DEV_PASSWORD=        # 주소에 ?dev=1 을 붙였을 때 개발자 화면을 여는 비밀번호
# DEV_ALLOW_OPEN=1     # 로컬에서만, 비밀번호 없이 개발자 화면을 열 때
# QUERY_LOG=0          # 0이면 질문 이력을 저장하지 않는다
