# Streamlit Community Cloud → 앱 Settings → Secrets 에 붙여 넣을 키 이름(값은 팀 .env에서 직접 옮긴다).
# 이 파일에는 실제 값을 쓰지 않는다. 최상위 키는 앱 안에서 환경 변수로도 노출된다.
NEO4J_URI = "neo4j+s://<instance>.databases.neo4j.io"
NEO4J_USERNAME = "<username>"
NEO4J_PASSWORD = "<password>"
NEO4J_DATABASE = "<database>"
OPENAI_API_KEY = "<key>"
# 선택: 설정하면 화면 진입 시 비밀번호를 묻는다(공개 URL에서 API 비용 보호).
APP_PASSWORD = "<team-password>"
